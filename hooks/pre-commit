#!/usr/bin/env bash
# Pre-commit hook for the llm-edit dogfood workflow.
#
# Two checks, in order:
#   1. lint_parse — every staged source file in a supported language
#      must parse cleanly under tree-sitter. Catches AST-merge
#      whitespace/structure corruption the moment it would land,
#      instead of letting it metastasize across subsequent merges.
#   2. infer — backfill rename_symbol / structural ops from text edits
#      so the committed `.llm-edit/log.jsonl` stays aligned with the
#      tree. Recorded ops let the next merge use the semantic path
#      instead of the (lossy) AST text fallback.
#
# Both steps are best-effort: if the binaries aren't built yet, the
# hook prints a hint and exits 0 so it doesn't block first-time setup.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Allow override via env so users (and tests) can point at a built
# binary outside the repo without copying it in.
LINT_BIN="${LLM_EDIT_LINT_BIN:-$REPO_ROOT/target/release/lint_parse}"
LLM_BIN="${LLM_EDIT_BIN:-$REPO_ROOT/target/release/llm-edit}"

if [[ ! -x "$LINT_BIN" || ! -x "$LLM_BIN" ]]; then
  echo "pre-commit: llm-edit binaries not built yet; skipping checks." >&2
  echo "  run: cargo build --release" >&2
  exit 0
fi

# 1. Parse-check staged source files. Use newline-delimited paths and
# xargs for portability (bash 3 on macOS lacks `mapfile`).
STAGED="$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(py|js|jsx|mjs|cjs|ts|tsx|rs)$' || true)"

if [[ -n "$STAGED" ]]; then
  if ! echo "$STAGED" | xargs "$LINT_BIN"; then
    echo "pre-commit: aborting — fix the parse errors above and re-stage." >&2
    exit 1
  fi
fi

# 2. Infer ops from text edits and append to .llm-edit/log.jsonl.
# Only run if there are working-tree changes the infer pass can analyze.
# `infer` walks `git diff --name-only HEAD` so it sees both staged and
# unstaged source changes; we re-stage the log if it changed.
PRE_LOG_HASH=""
if [[ -f "$REPO_ROOT/.llm-edit/log.jsonl" ]]; then
  PRE_LOG_HASH="$(shasum "$REPO_ROOT/.llm-edit/log.jsonl" | awk '{print $1}')"
fi

if "$LLM_BIN" infer >/dev/null 2>&1; then
  POST_LOG_HASH=""
  if [[ -f "$REPO_ROOT/.llm-edit/log.jsonl" ]]; then
    POST_LOG_HASH="$(shasum "$REPO_ROOT/.llm-edit/log.jsonl" | awk '{print $1}')"
  fi
  if [[ "$PRE_LOG_HASH" != "$POST_LOG_HASH" ]]; then
    git add "$REPO_ROOT/.llm-edit/log.jsonl"
    echo "pre-commit: backfilled op(s) into .llm-edit/log.jsonl (auto-staged)." >&2
  fi
fi
